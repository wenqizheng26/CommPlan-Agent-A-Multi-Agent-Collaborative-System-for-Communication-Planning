flowchart TB
    U(["用户输入自然语言<br/>提出目标、条件或后续修改"])
    subgraph LG["LangGraph / StateGraph · 有状态多 Agent 工作流"]
        START["任务入口<br/>新任务 / 更新已有任务"]
        O["Orchestrator Agent · 总控<br/>依据任务状态选择合法下一步"]
        RK["需求与知识 Agent<br/>理解目标、硬约束与缺项"]
        CP["计算规划 Agent<br/>选择模型、公式链与候选搜索计划"]
        VE["验证与解释 Agent<br/>审查证据、结果与方案取舍"]
        FW["结构化抽取 Worker<br/>抽取 / 更新字段 · 自动填表"]
        SU["程序校验与状态提交<br/>分别接收各节点产物 · 校验权限、格式与版本"]
        GATE{"确定性条件路由<br/>缺项 / 确认 / 进度 / 预算"}
        HITL["用户核对与确认<br/>补充或修正表格<br/>确认模型、约束与可调范围"]
        TOOL["确定性执行子图<br/>候选生成 → 前置校核<br/>批量计算 → 后置校核"]
        EA["逐方案工程评估 · 程序<br/>满足 / 不满足 / 暂无法判定 / 不涉及"]
        CMP["方案比较 · 程序<br/>并列比较不同取舍<br/>保留未达标与未完成原因"]
        OUT["结果与证据包<br/>方案对比、数值、公式与来源<br/>适用范围、假设与版本"]
        STOP["停止受影响分支并报告<br/>能力缺口 / 故障 / 预算耗尽<br/>保留有效部分结果"]
        GS[("Graph State + 本地检查点<br/>参数、确认、计划、证据<br/>候选、结果、审查与版本")]

        U --> START
        START --> O
        O -->|需求理解或参数更新| RK
        O -->|规划或调整方案| CP
        O -->|结果审查或解释追问| VE
        RK --> FW
        FW -->|字段与依据| SU
        CP -->|模型与计算计划| SU
        VE -->|审查与解释| SU
        SU --> GATE
        GATE -->|需补充或确认| HITL
        HITL -->|校验提交后恢复| SU
        GATE -->|待规划或待审查| O
        GATE -->|确认有效且可执行| TOOL
        TOOL --> EA
        EA --> CMP
        CMP -->|比较与执行记录| SU
        GATE -->|当前版本审查通过且满足发布条件| OUT
        GATE -->|当前无法继续| STOP
        SU -.->|受控更新| GS
        GS -.->|提供必要状态| O
    end
    CHOICE(["用户选择并保存<br/>需要修改时继续自然语言输入"])
    OUT --> CHOICE
    subgraph KNOW["共享知识支持 · 图面独立布置，按需调用"]
        RAG["共享 RAG 检索<br/>模型依据、参数定义、适用条件与证据"]
        KB[("本地知识库<br/>标准、公式依据、经审核资料")]
        RAG -.->|读取| KB
    end
    RK -.->|独立检索调用| RAG
    CP -.->|独立检索调用| RAG
    VE -.->|独立检索调用| RAG

    classDef user fill:#edf7f1,stroke:#3c8767,color:#173e2e;
    classDef agent fill:#f3edfb,stroke:#8b69b6,color:#382451;
    classDef program fill:#edf4fc,stroke:#5980aa,color:#243f5d;
    classDef tool fill:#eaf6f6,stroke:#459297,color:#214f52;
    classDef gate fill:#fff5df,stroke:#bc913d,color:#664d1c;
    classDef stop fill:#fcefeb,stroke:#b97864,color:#65392c;
    classDef store fill:#f2f5f8,stroke:#8d9aac,color:#3c4c61;
    class U,HITL,CHOICE user;
    class O,RK,CP,VE agent;
    class START,SU,OUT program;
    class FW,TOOL,EA,CMP,RAG tool;
    class GATE gate;
    class STOP stop;
    class GS,KB store;

