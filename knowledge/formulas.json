[
  {
    "id": "fspl_ghz",
    "title": "自由空间基本传输损耗",
    "description": "自由空间点对点通信的路径损耗基准。频率用 GHz、距离用 km；不包含遮挡、海面反射、多径、雨衰、气体吸收或天线馈线损耗。只有明确采用自由空间模型或明确请求自由空间基准时适用，视距本身不等同于自由空间。",
    "version": "1.0.0",
    "status": "verified",
    "expression": "92.4 + 20*log10(frequency_ghz) + 20*log10(distance_km)",
    "output": {
      "name": "path_loss_db",
      "unit": "dB"
    },
    "parameters": {
      "frequency_ghz": {
        "unit": "GHz",
        "description": "载波频率",
        "exclusive_min": 0
      },
      "distance_km": {
        "unit": "km",
        "description": "发射端到接收端的路径距离",
        "exclusive_min": 0,
        "search_range": [0.001, 1000]
      }
    },
    "applicability": {
      "requires": [
        "free_space"
      ],
      "notes": [
        "适用于源尺寸和波长允许的远场自由空间传播。用户确认的是模型假设，程序不据此声称实际场地满足假设。",
        "使用 ITU-R 式(6)的舍入常数：32.4 + 20log10(1000) = 92.4。与用精确光速和 4π 计算的常数有约 0.048 dB 差异。"
      ]
    },
    "sources": [
      {
        "title": "ITU-R P.525-5 (11/2024), Calculation of free-space attenuation",
        "url": "https://www.itu.int/dms_pubrec/itu-r/rec/p/R-REC-P.525-5-202411-I!!PDF-E.pdf",
        "locator": "Annex 1 and 2.3; printed pages 1 and 3; equation (6)",
        "checked_date": "2026-09-14",
        "derivation": "原式 f 为 MHz、d 为 km；此卡将 f 换为 GHz，保持原标准舍入常数。"
      }
    ],
    "examples": [
      {
        "inputs": {
          "frequency_ghz": 4.5,
          "distance_km": 0.2
        },
        "expected": 91.48485018878651,
        "tolerance": 1e-10
      },
      {
        "inputs": {
          "frequency_ghz": 4.5,
          "distance_km": 0.4
        },
        "expected": 97.50545010206613,
        "tolerance": 1e-10
      }
    ]
  },
  {
    "id": "doppler_max",
    "title": "单程最大多普勒频移上界",
    "description": "用相对速率估计单程无线电链路的一阶多普勒频移幅度上界。上界取全部速度为径向分量；实际有符号频移还需要运动方向，不是任意方向的实际频移，也不适用于双程雷达。",
    "version": "1.0.0",
    "status": "verified",
    "expression": "frequency_ghz * 1000000000 * (speed_kmh / 3.6) / 299792458",
    "output": {
      "name": "maximum_doppler_hz",
      "unit": "Hz"
    },
    "parameters": {
      "frequency_ghz": {
        "unit": "GHz",
        "description": "载波频率",
        "exclusive_min": 0
      },
      "speed_kmh": {
        "unit": "km/h",
        "description": "收发端相对速率的非负幅值",
        "min": 0,
        "max": 1079252.8488
      }
    },
    "applicability": {
      "requires": [
        "maximum_doppler"
      ],
      "notes": [
        "一阶非相对论近似，以 |径向速度| ≤ 相对速率 得到幅度上界。",
        "项目计算范围限制为 v ≤ 0.001c，以避免将低速近似用于接近光速的输入；这是实现范围，不是来源规定的物理阈值。"
      ]
    },
    "sources": [
      {
        "title": "NASA/JPL IPN Progress Report 42-154, Biswas and Piazzolla (2003)",
        "url": "https://ipnpr.jpl.nasa.gov/progress_report/42-154/154L.pdf",
        "locator": "printed page 21, equation (14)",
        "checked_date": "2026-09-14",
        "derivation": "原文为电磁波单程径向一阶频移；由径向分量的幅值不超过相对速率得到最大幅度上界。"
      },
      {
        "title": "NIST CODATA: speed of light in vacuum",
        "url": "https://physics.nist.gov/cuu/Constants/Value/c.html",
        "locator": "Numerical value: 299792458 m/s, exact",
        "checked_date": "2026-09-14"
      }
    ],
    "examples": [
      {
        "inputs": {
          "frequency_ghz": 4.5,
          "speed_kmh": 108
        },
        "expected": 450.3115285175053,
        "tolerance": 1e-09
      }
    ]
  },
  {
    "id": "thermal_noise",
    "title": "指定温度与带宽的热噪声功率",
    "description": "按 N=kTB 计算指定等效噪声温度和噪声等效带宽内的可用热噪声功率，转换为 dBm。温度必须显式输入，不默认 290 K，也不将比特率直接当作噪声带宽。",
    "version": "1.0.0",
    "status": "verified",
    "expression": "10*log10(1.380649e-23 * temperature_k * bandwidth_hz * 1000)",
    "output": {
      "name": "noise_power_dbm",
      "unit": "dBm"
    },
    "parameters": {
      "temperature_k": {
        "unit": "K",
        "description": "输入参考面上的等效噪声温度",
        "exclusive_min": 0
      },
      "bandwidth_hz": {
        "unit": "Hz",
        "description": "噪声等效带宽，不是未经说明的比特率",
        "exclusive_min": 0
      }
    },
    "applicability": {
      "requires": [],
      "notes": [
        "经典热噪声模型，匹配接收输入的可用功率；射频能量量子远小于 kT。",
        "温度、带宽和噪声参考面由用户明确提供；未自动增加接收机噪声系数或外部干扰功率。",
        "采用 SI 精确定义的 Boltzmann 常数 1.380649e-23 J/K。"
      ]
    },
    "sources": [
      {
        "title": "NASA Radio JOVE, Tech Talk #1 - Antenna Temperature",
        "url": "https://radiojove.gsfc.nasa.gov/radio_telescope/resources/tech_talk-1.php",
        "locator": "P=kTB equation, variable definitions and matched input condition",
        "checked_date": "2026-09-14",
        "derivation": "将瓦特乘 1000 转成毫瓦，再取 10log10 得 dBm。"
      },
      {
        "title": "NIST: Kelvin - Boltzmann Constant",
        "url": "https://www.nist.gov/si-redefinition/kelvin/kelvin-boltzmann-constant",
        "locator": "fixed SI value 1.380649 x 10^-23 J/K",
        "checked_date": "2026-09-14"
      }
    ],
    "examples": [
      {
        "inputs": {
          "temperature_k": 290,
          "bandwidth_hz": 1000000
        },
        "expected": -113.97518719422808,
        "tolerance": 1e-09
      }
    ]
  },
  {
    "id": "received_power",
    "title": "链路预算接收电平",
    "description": "按发射功率加收发天线增益、减去馈线、路径及额外损耗计算接收功率。路径损耗必须来自适用模型、测量或用户明确提供；此式不会根据环境自动估出路径损耗。",
    "version": "1.0.0",
    "status": "verified",
    "expression": "tx_power_dbm + tx_gain_dbi + rx_gain_dbi - tx_loss_db - rx_loss_db - path_loss_db - extra_loss_db",
    "output": {
      "name": "rx_power_dbm",
      "unit": "dBm"
    },
    "parameters": {
      "tx_power_dbm": {
        "unit": "dBm",
        "description": "发射机输出功率，不是已含天线增益的 EIRP",
        "search_range": [-30, 70]
      },
      "tx_gain_dbi": {
        "unit": "dBi",
        "description": "发射天线沿接收方向的增益，参考各向同性天线"
      },
      "rx_gain_dbi": {
        "unit": "dBi",
        "description": "接收天线沿发射方向的增益，参考各向同性天线"
      },
      "tx_loss_db": {
        "unit": "dB",
        "description": "发射馈线损耗；无损耗请显式填写 0",
        "min": 0,
        "default": {"value": 2, "unit": "dB", "note": "工程假设，典型取值，非标准值；请按实际馈线修改"}
      },
      "rx_loss_db": {
        "unit": "dB",
        "description": "接收馈线损耗；无损耗请显式填写 0",
        "min": 0,
        "default": {"value": 2, "unit": "dB", "note": "工程假设，典型取值，非标准值；请按实际馈线修改"}
      },
      "path_loss_db": {
        "unit": "dB",
        "description": "符合场景的基本路径损耗，不重复包含天线增益或馈线损耗",
        "min": 0
      },
      "extra_loss_db": {
        "unit": "dB",
        "description": "尚未计入其他项的额外损耗；无损耗请显式填写 0",
        "min": 0,
        "default": {"value": 0, "unit": "dB", "note": "按自由空间假设，不计其他损耗"}
      }
    },
    "applicability": {
      "requires": [],
      "notes": [
        "所有项必须属于同一条单程链路、同一频率和一致功率参考面。",
        "本式只做功率收支，不由正接收功率或正余量推断现场可用率。"
      ]
    },
    "sources": [
      {
        "title": "NASA, State-of-the-Art of Small Spacecraft Technology, Ground Data Systems and Mission Operations",
        "url": "https://www.nasa.gov/smallsat-institute/sst-soa/ground-data-systems-and-mission-operations/",
        "locator": "11.3.1 Frequency Selection: Link Budget",
        "checked_date": "2026-09-14",
        "derivation": "对文中描述的 RF 功率预算按统一参考面展开，正值损耗取减号。"
      }
    ],
    "examples": [
      {
        "inputs": {
          "tx_power_dbm": 40,
          "tx_gain_dbi": 2,
          "rx_gain_dbi": 2,
          "tx_loss_db": 2,
          "rx_loss_db": 2,
          "path_loss_db": 91.48485018878651,
          "extra_loss_db": 0
        },
        "expected": -51.48485018878651,
        "tolerance": 1e-10
      }
    ]
  },
  {
    "id": "link_margin",
    "title": "扣除预留量后的链路电平余量",
    "description": "计算接收电平高于接收门限的余量，再扣除用户指定的工程预留量。接收门限必须对应同一调制、码率及误码或丢包要求；正余量不等于已经验证现场可靠度。",
    "version": "1.0.0",
    "status": "verified",
    "expression": "rx_power_dbm - rx_threshold_dbm - reserve_db",
    "output": {
      "name": "link_margin_db",
      "unit": "dB"
    },
    "parameters": {
      "rx_power_dbm": {
        "unit": "dBm",
        "description": "接收端输入参考面的信号电平"
      },
      "rx_threshold_dbm": {
        "unit": "dBm",
        "description": "满足指定通信质量的接收灵敏度或门限"
      },
      "reserve_db": {
        "unit": "dB",
        "description": "未计入接收电平或门限的工程预留量；不预留请显式填写 0",
        "min": 0,
        "default": {"value": 0, "unit": "dB", "note": "要求余量单独比较，不预先扣除"}
      }
    },
    "applicability": {
      "requires": [],
      "notes": [
        "接收电平和门限必须使用同一输入参考面，避免把已经扣减的损耗再次作为预留量扣减。",
        "reserve_db 是此项目显式扣除的预留量；来源中的基本余量为接收功率减灵敏度。"
      ]
    },
    "sources": [
      {
        "title": "Texas Instruments SWRA479A, Achieving Optimum Radio Range (2017)",
        "url": "https://www.ti.com/lit/an/swra479a/swra479a.pdf",
        "locator": "page 4, section 2.4: link margin definition",
        "checked_date": "2026-09-14",
        "derivation": "采用接收功率减灵敏度的定义；此项目再扣除显式 reserve_db。"
      }
    ],
    "examples": [
      {
        "inputs": {
          "rx_power_dbm": -51.48485018878651,
          "rx_threshold_dbm": -62,
          "reserve_db": 0
        },
        "expected": 10.51514981121349,
        "tolerance": 1e-10
      }
    ]
  },
  {
    "id": "noise_density",
    "title": "指定温度的热噪声谱密度",
    "description": "由明确给出的参考噪声温度计算 kT 并转换为 dBm/Hz。温度必须输入，不默认为290 K。",
    "version": "1.0.0",
    "status": "verified",
    "expression": "10*log10(1.380649e-23*temperature_k*1000)",
    "output": {
      "name": "noise_density_dbm_hz",
      "unit": "dBm/Hz"
    },
    "parameters": {
      "temperature_k": {
        "unit": "K",
        "description": "尚未计入接收机噪声系数的参考噪声温度",
        "exclusive_min": 0
      }
    },
    "applicability": {
      "requires": [],
      "notes": [
        "用于接收门限时，输入为参考热噪声温度；若谱密度已经包含接收机附加噪声，不能再重复加噪声系数。"
      ]
    },
    "sources": [
      {
        "title": "Analog Devices, Improving Receiver Sensitivity with External LNA",
        "url": "https://www.analog.com/en/resources/technical-articles/improving-receiver-sensitivity-with-external-lna.html",
        "locator": "Receiver sensitivity S = NF + S/N + thermal noise; noise density at 290 K",
        "checked_date": "2026-09-14"
      },
      {
        "title": "NIST CODATA: Boltzmann constant",
        "url": "https://physics.nist.gov/cuu/Constants/Value/k.html",
        "locator": "k = 1.380649e-23 J/K, exact"
      }
    ],
    "examples": [
      {
        "inputs": {
          "temperature_k": 290
        },
        "expected": -173.97518719422808,
        "tolerance": 1e-10
      }
    ]
  },
  {
    "id": "receiver_threshold",
    "title": "由 Eb/N0 与比特率计算接收门限",
    "description": "按噪声谱密度、比特速率、所需 Eb/N0、接收机噪声系数和工程损失计算接收门限。参考噪声谱密度必须明确输入，或由显式参考温度计算；不会固定为-174。",
    "version": "1.0.0",
    "status": "verified",
    "expression": "noise_density_dbm_hz + 10*log10(bit_rate_bps) + ebn0_db + noise_figure_db + engineering_loss_db",
    "output": {
      "name": "rx_threshold_dbm",
      "unit": "dBm"
    },
    "parameters": {
      "noise_density_dbm_hz": {
        "unit": "dBm/Hz",
        "description": "接收机附加噪声之前的参考噪声谱密度；已含噪声系数时不可重复加算"
      },
      "bit_rate_bps": {
        "unit": "bit/s",
        "description": "与 Eb/N0 定义一致的信息比特率；不能混用符号率或编码后速率",
        "exclusive_min": 0
      },
      "ebn0_db": {
        "unit": "dB",
        "description": "指定调制、编码和误码率下所需 Eb/N0，以dB输入"
      },
      "noise_figure_db": {
        "unit": "dB",
        "description": "相对于所采用参考温度的接收机噪声系数，不能与输入谱密度重复计入",
        "min": 0
      },
      "engineering_loss_db": {
        "unit": "dB",
        "description": "尚未计入 Eb/N0 门限的实现或工程损失；无损失需输入0",
        "min": 0
      }
    },
    "applicability": {
      "requires": [],
      "notes": [
        "由 Eb/N0 = C/N0 - 10log10(Rb) 移项，加入尚未计入的接收机噪声系数和工程损失。比特速率单位为 bit/s，不把它当作噪声带宽。",
        "噪声谱密度和噪声系数需采用一致的参考温度；输入若已含接收机噪声，噪声系数项应明确为0。",
        "-174 dBm/Hz 是约290 K时的常用舍入值；使用精确k和290 K得到-173.97518719，两者有0.02481281 dB差异。"
      ]
    },
    "sources": [
      {
        "title": "NASA/TM-2002-212006, Appendix 1: Test Descriptions",
        "url": "https://ntrs.nasa.gov/api/citations/20030015751/downloads/20030015751.pdf",
        "locator": "printed page 15, section 2: Eb/No = C/No - 10 log(data rate)",
        "checked_date": "2026-09-14",
        "verification_copy": "https://citeseerx.ist.psu.edu/document?doi=0e1acf446a4b6282eececfaebdb9ef8ebe04a4e4&repid=rep1&type=pdf"
      },
      {
        "title": "Analog Devices, Improving Receiver Sensitivity with External LNA",
        "url": "https://www.analog.com/en/resources/technical-articles/improving-receiver-sensitivity-with-external-lna.html",
        "locator": "Receiver sensitivity S = NF + S/N + thermal noise; noise density at 290 K",
        "checked_date": "2026-09-14"
      }
    ],
    "examples": [
      {
        "inputs": {
          "noise_density_dbm_hz": -174,
          "bit_rate_bps": 1000000000.0,
          "ebn0_db": 15,
          "noise_figure_db": 4,
          "engineering_loss_db": 3
        },
        "expected": -62,
        "tolerance": 1e-10
      }
    ]
  },
  {
    "id": "radio_horizon",
    "title": "标准大气假设下的两端无线电视距",
    "description": "按等效地球半径系数 k = 4/3 估算两端天线的无线电地平线距离之和；不考虑中间地形遮挡或菲涅耳区余隙，不能单独证明链路可用。",
    "version": "1.0.0",
    "status": "verified",
    "expression": "4.12*(sqrt(antenna1_m)+sqrt(antenna2_m))",
    "output": {"name": "radio_horizon_km", "unit": "km"},
    "parameters": {
      "antenna1_m": {"unit": "m", "description": "第一端天线离地高度", "min": 0},
      "antenna2_m": {"unit": "m", "description": "第二端天线离地高度", "min": 0}
    },
    "applicability": {
      "requires": [],
      "notes": ["k = 4/3 为标准大气的典型等效地球半径系数；不含地形遮挡和菲涅耳区余隙。"]
    },
    "sources": [{
      "title": "ITU-R, Radiowave propagation information for designing terrestrial point-to-point links (2009)",
      "url": "https://www.itu.int/dms_pub/itu-r/opb/hdb/R-HDB-54-2009-OAS-PDF-E.pdf",
      "locator": "Part 1, section 3.3: effective Earth radius factor k about 4/3",
      "checked_date": "2026-09-25",
      "derivation": "由 d≈sqrt(2kRh) 对两端求和，k=4/3、R≈6371 km，h 单位 m，系数约 4.12 km/sqrt(m)；4.12 是舍入值。"
    }],
    "examples": [
      {"inputs": {"antenna1_m": 30, "antenna2_m": 25}, "expected": 43.16616936921285, "tolerance": 1e-9},
      {"inputs": {"antenna1_m": 30, "antenna2_m": 15}, "expected": 38.5228607555874, "tolerance": 1e-9}
    ]
  },
  {
    "id": "slant_range_wgs84",
    "title": "WGS84 两端天线直线距离",
    "description": "将两端 WGS84 经纬度与椭球高转换为地心直角坐标，求两天线相位中心之间的弦长。地面高程加天线离地高度在此卡中按 WGS84 椭球高处理；若实测高程基准不同，需先转换。",
    "version": "1.0.0",
    "status": "verified",
    "kind": "python_tool",
    "algorithm": "WGS84 椭球参数 a=6378137 m、f=1/298.257223563；每端椭球高=ground_m+antenna_m；经纬高转换为 ECEF X/Y/Z 后，以欧氏距离求两点弦长并换算为 km。",
    "output": {"name": "distance_km", "unit": "km"},
    "parameters": {
      "lat1_deg": {"unit": "deg", "description": "第一端 WGS84 纬度", "min": -90, "max": 90},
      "lon1_deg": {"unit": "deg", "description": "第一端 WGS84 经度", "min": -180, "max": 180},
      "ground1_m": {"unit": "m", "description": "第一端地面 WGS84 椭球高"},
      "antenna1_m": {"unit": "m", "description": "第一端天线离地高度", "min": 0},
